//@version=6
// =============================================================================
// NEXUS EA — Strategia FVG_CONT (FVG 3 candele + trend H1 esterno) — XAUUSD H4
// -----------------------------------------------------------------------------
// Terzo motore di verifica indipendente (TradingView) per NXS_Strat_FVG
// (NXS_Strategies.mqh:404) e il profilo attuale (NXS_StrategyProfiles.mqh:
// FVG_CONT -> slMult=1.0, tpMult=4.5, htf=true, beR=0, trailATR=0, PERIOD_H4).
//
// Trigger (identico a MQL5, su barra CHIUSA, offset[1]/[3] = shift[1]/[3]):
//   BUY  : low[1] > high[3]  (gap a 3 candele)  E  trend H1 ESTERNO = rialzista
//   SELL : high[1] < low[3]  E  trend H1 ESTERNO = ribassista
//
// Trend H1 esterno (g_structH1 in MQL5): calcolato SEMPRE su H1, indipendente
// dal timeframe della strategia (qui H4) — fix reale del 16/07 che sostituì
// un proxy EMA50 locale col vero trend esterno multi-timeframe. Stesso motore
// struttura di NEXUS_IFVG.pine/NEXUS_SMS_BMS_RTO.pine (pivot fractal ala 3
// barre, HH+HL=up/LH+LL=down con isteresi), qui letto via request.security su
// "60" invece che sul TF del chart.
//
// SEMPLIFICAZIONE NOTA (omessa di proposito, stessa di NEXUS_ORDER_BLOCK.pine):
// il gate "SMC reaction" (NXS_SMCReactionOK, InpUseSMCReactionGate) che in
// MQL5 può cancellare il segnale se la reazione del prezzo non è di qualità
// sufficiente NON è replicato — sistema generico condiviso con altre
// strategie, filtro aggiuntivo rispetto al trigger base. La versione Pine
// qui è quindi meno filtrata (più segnali) del comportamento MT5 reale
// quando quel gate è attivo (default MQL5 non confermato in questa sessione).
//
// Filtro HTF: attivo (EMA200 stesso TF H4, gate generico di profilo,
// indipendente dal trend H1 sopra — quello è nel TRIGGER, questo è un gate
// aggiuntivo a valle).
//
// Timing barra / anti-repaint: calc_on_every_tick=false.
// =============================================================================
strategy("NEXUS EA - FVG_CONT (XAUUSD H4)", shorttitle="NXS-FVGCONT", overlay=true,
     calc_on_every_tick=false, pyramiding=0, default_qty_type=strategy.fixed,
     default_qty_value=1, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract, commission_value=0,
     slippage=0)

// ----------------------------- Input --------------------------------------
swingWing = input.int(3, "Struttura H1: ala del pivot (barre per lato)")
useHtfFilter = input.bool(true, "Filtro HTF (EMA200 stesso TF)")
atrLen = input.int(14, "ATR length")
slMult = input.float(1.0, "SL (x ATR)")
tpMult = input.float(4.5, "TP (x ATR)")
maxHoldBars = input.int(40, "Time-exit (barre)")
startDate = input.time(timestamp("2019-01-01T00:00:00"), "Backtest da")
endDate   = input.time(timestamp("2026-12-31T00:00:00"), "Backtest a")

// ----------------------------- Indicatori ----------------------------------
atrVal = ta.atr(atrLen)
ema200 = ta.ema(close, 200)
inRange = time >= startDate and time <= endDate

// ----------------------------- Trend H1 esterno (motore struttura) ----------
f_h1_trend() =>
    ph = ta.pivothigh(swingWing, swingWing)
    pl = ta.pivotlow(swingWing, swingWing)
    var float lastHi = na
    var float prevHi = na
    var float lastLo = na
    var float prevLo = na
    if not na(ph)
        prevHi := lastHi
        lastHi := ph
    if not na(pl)
        prevLo := lastLo
        lastLo := pl
    var int trend = 0
    if not na(lastHi) and not na(prevHi) and not na(lastLo) and not na(prevLo)
        hh = lastHi > prevHi
        hl = lastLo > prevLo
        lh = lastHi < prevHi
        ll = lastLo < prevLo
        if hh and hl
            trend := 1
        else if lh and ll
            trend := -1
    trend

structH1Trend = request.security(syminfo.tickerid, "60", f_h1_trend(), lookahead=barmerge.lookahead_off)

// ----------------------------- Gap 3 candele ---------------------------------
h3 = high[3]
l3 = low[3]
h1v = high[1]
l1v = low[1]

// ----------------------------- Trigger --------------------------------------
rawLong  = l1v > h3 and structH1Trend == 1
rawShort = h1v < l3 and structH1Trend == -1

htfBlocksBuy  = useHtfFilter and close < ema200
htfBlocksSell = useHtfFilter and close > ema200

longCond  = inRange and rawLong  and not htfBlocksBuy
shortCond = inRange and rawShort and not htfBlocksSell

if longCond and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, comment="FVG_cont bull (ext)")
if shortCond and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, comment="FVG_cont bear (ext)")

// ----------------------------- Gestione SL/TP/Time-exit ---------------------
var float slLevel    = na
var float tpLevel    = na
var float atrAtEntry = na
var int   entryBarIdx = na

newPosition = strategy.position_size != 0 and strategy.position_size[1] == 0
if newPosition
    atrAtEntry := atrVal
    entryBarIdx := bar_index
    if strategy.position_size > 0
        slLevel := strategy.position_avg_price - atrAtEntry * slMult
        tpLevel := strategy.position_avg_price + atrAtEntry * tpMult
    else
        slLevel := strategy.position_avg_price + atrAtEntry * slMult
        tpLevel := strategy.position_avg_price - atrAtEntry * tpMult

if strategy.position_size != 0 and not na(entryBarIdx) and (bar_index - entryBarIdx) >= maxHoldBars
    strategy.close_all(comment="TimeExit")

if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", stop=slLevel, limit=tpLevel)
if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", stop=slLevel, limit=tpLevel)

// ----------------------------- Plot / avviso TF -----------------------------
plot(ema200, title="EMA200", color=color.new(color.orange, 30))
plotshape(longCond, title="FVG_CONT Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(shortCond, title="FVG_CONT Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

if barstate.islast and timeframe.period != "240"
    label.new(bar_index, high, "⚠ Questa strategia è tarata su H4 — imposta il chart a 4 ore", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

alertcondition(longCond, "NXS FVG_CONT BUY", "NEXUS FVG_CONT: gap 3 candele rialzista + trend H1 concorde")
alertcondition(shortCond, "NXS FVG_CONT SELL", "NEXUS FVG_CONT: gap 3 candele ribassista + trend H1 concorde")
