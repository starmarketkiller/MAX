//@version=6
// =============================================================================
// NEXUS EA — Strategia WEEKLY_EXP (espansione settimanale, discount/premium + displacement H4) — XAUUSD D1
// -----------------------------------------------------------------------------
// Terzo motore di verifica indipendente (TradingView) per
// NXS_Strat_WeeklyRangeExp (MQL5/Include/NEXUS_v1/NXS_Strategies_Institutional.mqh:317)
// e il profilo attuale (NXS_StrategyProfiles.mqh: WEEKLY_EXP -> PERIOD_D1,
// htf/slMult/tpMult non applicati direttamente: SL/TP sono geometrici/Fibonacci,
// vedi sotto — proxy_for=BREAKOUT_ACC nel motore Python di ricerca, MA in
// MQL5 ha una funzione dedicata, non un alias — verificato).
//
// Trigger (identico a MQL5, su barra CHIUSA D1, con dati H4/W1 cross-TF):
//   1) Prev Week High/Low (PWH/PWL) e apertura della settimana corrente
//      (W1, shift0 — informazione già nota, nessun lookahead).
//   2) Displacement H4: corpo della barra H4 shift1 >= 0.8×ATR H4 DEDICATO
//      (non l'ATR D1 del profilo — bug reale corretto il 17/07: unità
//      diverse rendevano la soglia quasi irraggiungibile).
//   3) BOS H4: la chiusura H4 shift1 rompe uno swing H4 di riferimento
//      (massimo/minimo delle 15 barre H4 precedenti, shift2..16).
//   4) CHoCH nella stessa direzione (motore struttura NATIVO D1, stesso
//      porting pivot-fractal di NEXUS_IFVG.pine/NEXUS_SMS_BMS_RTO.pine).
//   BUY  : prezzo sotto il midpoint PWH/PWL (discount) E displacement H4
//          rialzista con BOS E prezzo sopra l'apertura settimanale E CHoCH
//          rialzista.
//   SELL : speculare (premium, displacement ribassista, sotto l'apertura
//          settimanale, CHoCH ribassista).
//
// SL/TP (pending, geometrico + estensione Fibonacci 1.272 della settimana
// precedente, NON un multiplo ATR generico):
//   BUY : SL = min(PWL, entry - 1.5×ATR_D1), TP = max(PWH, PWH+0.272×leg,
//         entry + 2.6×(entry-SL))  [leg = PWH-PWL]
//   SELL: speculare
//
// SEMPLIFICAZIONE NOTA: "bid" (prezzo live in MQL5, usato per il confronto
// col midpoint e come riferimento SL/TP) è approssimato con la chiusura
// della barra D1, come nelle altre strategie di questo portafoglio.
//
// Nessun filtro di sessione intraday in questa strategia (a differenza di
// JUDAS_SWING/LDN_REVERSAL/NY_REVERSAL, rimandate — vedi pinescript/README.md).
//
// Timing barra / anti-repaint: calc_on_every_tick=false.
// =============================================================================
strategy("NEXUS EA - WEEKLY_EXP (XAUUSD D1)", shorttitle="NXS-WKEXP", overlay=true,
     calc_on_every_tick=false, pyramiding=0, default_qty_type=strategy.fixed,
     default_qty_value=1, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract, commission_value=0,
     slippage=0)

// ----------------------------- Input --------------------------------------
swingWing = input.int(3, "Struttura D1: ala del pivot (barre per lato)")
dispBodyMult = input.float(0.8, "Displacement H4: corpo minimo × ATR H4")
h4SwingLookback = input.int(15, "BOS H4: barre di riferimento")
slAtrMult = input.float(1.5, "SL: buffer alternativo × ATR D1")
fibExtMult = input.float(0.272, "Estensione Fibonacci del leg settimanale")
rMult = input.float(2.6, "TP: multiplo R minimo di garanzia")
atrLen = input.int(14, "ATR length (D1)")
maxHoldBars = input.int(40, "Time-exit (barre)")
startDate = input.time(timestamp("2019-01-01T00:00:00"), "Backtest da")
endDate   = input.time(timestamp("2026-12-31T00:00:00"), "Backtest a")

// ----------------------------- Indicatori ----------------------------------
atrVal = ta.atr(atrLen)
inRange = time >= startDate and time <= endDate

// ----------------------------- Dati settimanali ------------------------------
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)
wOpen = request.security(syminfo.tickerid, "W", open, lookahead=barmerge.lookahead_off)

// ----------------------------- Dati H4 (displacement + BOS) ------------------
cH4 = request.security(syminfo.tickerid, "240", close[1], lookahead=barmerge.lookahead_off)
oH4 = request.security(syminfo.tickerid, "240", open[1],  lookahead=barmerge.lookahead_off)
atrH4 = request.security(syminfo.tickerid, "240", ta.atr(14)[1], lookahead=barmerge.lookahead_off)
swingHiH4 = request.security(syminfo.tickerid, "240", ta.highest(high[2], h4SwingLookback), lookahead=barmerge.lookahead_off)
swingLoH4 = request.security(syminfo.tickerid, "240", ta.lowest(low[2],  h4SwingLookback), lookahead=barmerge.lookahead_off)

bH4 = math.abs(cH4 - oH4)
dispOK = bH4 >= dispBodyMult * atrH4
bosUpH4   = swingHiH4 > 0 and cH4 > swingHiH4
bosDownH4 = swingLoH4 > 0 and cH4 < swingLoH4

// ----------------------------- Motore struttura (BOS/CHoCH, D1 nativo) ------
ph = ta.pivothigh(swingWing, swingWing)
pl = ta.pivotlow(swingWing, swingWing)

var float lastSwingHigh = na
var float prevSwingHigh = na
var float lastSwingLow  = na
var float prevSwingLow  = na
if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

var int structTrend = 0
trendBefore = structTrend
if not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow)
    hh = lastSwingHigh > prevSwingHigh
    hl = lastSwingLow > prevSwingLow
    lh = lastSwingHigh < prevSwingHigh
    ll = lastSwingLow < prevSwingLow
    if hh and hl
        structTrend := 1
    else if lh and ll
        structTrend := -1

c1s = close[1]
chochUp   = not na(lastSwingHigh) and c1s > lastSwingHigh and trendBefore == -1
chochDown = not na(lastSwingLow)  and c1s < lastSwingLow  and trendBefore == 1

// ----------------------------- Trigger --------------------------------------
wMid = (pwh + pwl) * 0.5
bidApprox = close

rawLong  = dispOK and bidApprox < wMid and cH4 > oH4 and bosUpH4   and bidApprox > wOpen and chochUp
rawShort = dispOK and bidApprox > wMid and cH4 < oH4 and bosDownH4 and bidApprox < wOpen and chochDown

longCond  = inRange and rawLong
shortCond = inRange and rawShort

// ----------------------------- SL/TP iniziali (pending, geometria + Fib) ----
var float pendingSL = na
var float pendingTP = na
var float slLevel   = na
var float tpLevel   = na
var int   entryBarIdx = na

newPosition = strategy.position_size != 0 and strategy.position_size[1] == 0
if newPosition
    slLevel := pendingSL
    tpLevel := pendingTP
    entryBarIdx := bar_index

if longCond and strategy.position_size <= 0
    entryPx = close
    sl = math.min(pwl, entryPx - slAtrMult * atrVal)
    leg = pwh - pwl
    fib1272 = pwh + fibExtMult * leg
    pendingSL := sl
    pendingTP := math.max(math.max(pwh, fib1272), entryPx + rMult * (entryPx - sl))
    strategy.entry("Long", strategy.long, comment="WK-EXP bull:disc+disp+fib1.272")
if shortCond and strategy.position_size >= 0
    entryPx = close
    sl = math.max(pwh, entryPx + slAtrMult * atrVal)
    leg = pwh - pwl
    fib1272 = pwl - fibExtMult * leg
    pendingSL := sl
    pendingTP := math.min(math.min(pwl, fib1272), entryPx - rMult * (sl - entryPx))
    strategy.entry("Short", strategy.short, comment="WK-EXP bear:prem+disp+fib1.272")

// ----------------------------- Time-exit + uscita ---------------------------
if strategy.position_size != 0 and not na(entryBarIdx) and (bar_index - entryBarIdx) >= maxHoldBars
    strategy.close_all(comment="TimeExit")

if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", stop=slLevel, limit=tpLevel)
if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", stop=slLevel, limit=tpLevel)

// ----------------------------- Plot / avviso TF -----------------------------
plot(pwh, title="Prev Week High", color=color.new(color.red, 30))
plot(pwl, title="Prev Week Low", color=color.new(color.lime, 30))
plot(wOpen, title="Week Open", color=color.new(color.gray, 30))
plotshape(longCond, title="WeeklyExp Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(shortCond, title="WeeklyExp Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

if barstate.islast and timeframe.period != "D"
    label.new(bar_index, high, "⚠ Questa strategia è tarata su D1 — imposta il chart a D1", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

alertcondition(longCond, "NXS WEEKLY_EXP BUY", "NEXUS WEEKLY_EXP: espansione rialzista da discount settimanale")
alertcondition(shortCond, "NXS WEEKLY_EXP SELL", "NEXUS WEEKLY_EXP: espansione ribassista da premium settimanale")
