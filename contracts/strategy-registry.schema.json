{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/strategy-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "strategies"],
  "properties": {
    "schema_version": {"const": 1},
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy_id","display_name","family","status","live_implementation","research_implementation","research_parity","proxy_for","supported_symbols","supported_timeframes","default_enabled","risk_class","auto_disable_eligible","selector_index","schema_version"],
        "properties": {
          "strategy_id": {"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},
          "display_name": {"type":"string","minLength":1},
          "family": {"enum":["TREND","REVERSAL","SMC","INSTITUTIONAL","RESEARCH"]},
          "status": {"enum":["ACTIVE","EXPERIMENTAL","SHADOW_ONLY","RESEARCH_ONLY","DEPRECATED","DISABLED"]},
          "live_implementation": {"type":"boolean"},
          "research_implementation": {"type":"boolean"},
          "research_parity": {"enum":["EXACT","FUNCTIONALLY_EQUIVALENT","APPROXIMATE","PROXY","NOT_IMPLEMENTED"]},
          "proxy_for": {"type":["string","null"]},
          "supported_symbols": {"type":"array","items":{"type":"string"},"minItems":1},
          "supported_timeframes": {"type":"array","items":{"type":"string"},"minItems":1},
          "default_enabled": {"type":"boolean"},
          "risk_class": {"type":"string","minLength":1},
          "auto_disable_eligible": {"type":"boolean"},
          "selector_index": {"type":["integer","null"],"minimum":1},
          "schema_version": {"const":1}
        }
      }
    }
  },
  "additionalProperties": false
}
