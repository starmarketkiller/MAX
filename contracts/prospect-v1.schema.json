{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus.local/contracts/prospect-v1.schema.json",
  "title": "NEXUS PROSPECT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prospect_id", "dedup_key", "display_name", "website", "email", "location", "source", "source_reference", "evidence", "observed_at", "provenance", "status", "created_at", "last_observed_at", "duplicate_observations"],
  "properties": {
    "prospect_id": {"type": "string", "pattern": "^PROSPECT_[A-Z0-9_]+$"},
    "dedup_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "display_name": {"type": "string"},
    "website": {"type": ["string", "null"]},
    "email": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "source_reference": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observed_at": {"type": "string"},
    "provenance": {"type": "object"},
    "status": {"const": "DISCOVERED"},
    "created_at": {"type": "string"},
    "last_observed_at": {"type": "string"},
    "duplicate_observations": {"type": "integer", "minimum": 0}
  }
}
