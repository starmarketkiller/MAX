{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus.local/contracts/artifact-reservation-v1.schema.json",
  "title": "NEXUS ARTIFACT_RESERVATION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservation_id", "owner_id", "task_id", "artifacts", "status", "created_at", "expires_at", "provenance"],
  "properties": {
    "reservation_id": {"type": "string"},
    "owner_id": {"type": "string"},
    "task_id": {"type": "string"},
    "status": {"enum": ["ACTIVE", "RELEASED", "STALE"]},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "released_at": {"type": ["string", "null"]},
    "provenance": {"type": "object"}
  }
}
