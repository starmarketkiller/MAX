{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus.local/contracts/research-control-center-v1.schema.json",
  "title": "RESEARCH_CONTROL_CENTER_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "status", "warnings", "provenance",
    "research_loop", "experiment_registry", "hypothesis_queue",
    "improvement_center", "research_memory", "agent_activity", "approval_center"
  ],
  "properties": {
    "schema_version": { "const": "research-control-center-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE"] },
    "warnings": { "type": "array", "items": { "$ref": "#/definitions/warning" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "verified", "head_hash", "records"],
      "properties": {
        "source": { "type": "string" },
        "verified": { "type": "boolean" },
        "head_hash": { "type": ["string", "null"] },
        "records": { "type": "integer", "minimum": 0 }
      }
    },
    "research_loop": { "type": "object" },
    "experiment_registry": { "$ref": "#/definitions/collection" },
    "hypothesis_queue": { "type": "object" },
    "improvement_center": { "$ref": "#/definitions/collection" },
    "research_memory": { "$ref": "#/definitions/collection" },
    "agent_activity": { "$ref": "#/definitions/collection" },
    "approval_center": {
      "type": "object",
      "required": ["items", "count", "actions_enabled", "reason"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object" } },
        "count": { "type": "integer", "minimum": 0 },
        "actions_enabled": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": { "code": { "type": "string" }, "detail": { "type": "string" } }
    },
    "collection": {
      "type": "object",
      "required": ["items", "count"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object" } },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
