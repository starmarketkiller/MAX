{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus.local/contracts/decision-registry-v1.schema.json",
  "title": "NEXUS DECISION_REGISTRY_V1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["decision_id", "title", "status", "decision", "provenance"],
    "properties": {
      "decision_id": {"type": "string"},
      "title": {"type": "string"},
      "status": {"enum": ["PROPOSED", "ACTIVE", "SUPERSEDED", "RETIRED"]},
      "decision": {"type": "string"},
      "provenance": {"type": "object"}
    }
  }
}
