{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI_FASHION_AGENCY_STATE_V1",
  "description": "Read-only Agency projection consumed by Jarvis (/agency). V2 fields added additively.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accounts",
    "agency_tasks",
    "alerts",
    "approvals",
    "awaiting_approval",
    "blocked_products",
    "campaigns_active",
    "commercial_actions_enabled",
    "content_queue",
    "content_ready",
    "costs_eur",
    "credits_pending_approval",
    "credits_spent",
    "engagement",
    "followers",
    "generated_at",
    "health",
    "kpis",
    "models_active",
    "models_casting",
    "models_total",
    "models_working",
    "next_actions",
    "products_found",
    "profit_eur",
    "published",
    "publishing_enabled",
    "revenue_eur",
    "scheduled",
    "schema_version",
    "store_blocked",
    "store_pending",
    "store_ready",
    "top_campaign",
    "top_model",
    "top_product",
    "trend_inputs",
    "views",
    "worker_blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "AI_FASHION_AGENCY_STATE_V1"
    },
    "health": {
      "enum": [
        "GREEN",
        "AMBER",
        "RED",
        "NOT_STARTED"
      ]
    },
    "models_total": {
      "type": "integer",
      "minimum": 0
    },
    "models_active": {
      "type": "integer",
      "minimum": 0
    },
    "models_casting": {
      "type": "integer",
      "minimum": 0
    },
    "campaigns_active": {
      "type": "integer",
      "minimum": 0
    },
    "content_queue": {
      "type": "integer",
      "minimum": 0
    },
    "store_ready": {
      "type": "integer",
      "minimum": 0
    },
    "store_blocked": {
      "type": "integer",
      "minimum": 0
    },
    "awaiting_approval": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "integer",
      "minimum": 0
    },
    "views": {
      "type": [
        "number",
        "string"
      ]
    },
    "engagement": {
      "type": [
        "number",
        "string"
      ]
    },
    "followers": {
      "type": [
        "number",
        "string"
      ]
    },
    "credits_pending_approval": {
      "type": "number"
    },
    "credits_spent": {
      "type": "number"
    },
    "revenue_eur": {
      "type": "number"
    },
    "costs_eur": {
      "type": "number"
    },
    "profit_eur": {
      "type": "number"
    },
    "top_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "top_campaign": {
      "type": [
        "string",
        "null"
      ]
    },
    "agency_tasks": {
      "type": "object",
      "required": [
        "total",
        "open"
      ]
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commercial_actions_enabled": {
      "const": false
    },
    "publishing_enabled": {
      "const": false
    },
    "generated_at": {
      "type": "string"
    },
    "trend_inputs": {
      "type": "integer",
      "minimum": 0
    },
    "products_found": {
      "type": "integer",
      "minimum": 0
    },
    "store_pending": {
      "type": "integer",
      "minimum": 0
    },
    "content_ready": {
      "type": "integer",
      "minimum": 0
    },
    "scheduled": {
      "type": "integer",
      "minimum": 0
    },
    "models_working": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "title",
          "status",
          "reasons"
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "what",
          "credits"
        ],
        "properties": {
          "kind": {
            "enum": [
              "GENERATION_PACK",
              "STORE_LISTING",
              "SOCIAL_POST"
            ]
          }
        }
      }
    },
    "accounts": {
      "type": "object",
      "required": [
        "total",
        "active",
        "not_created"
      ]
    },
    "top_product": {
      "type": [
        "string",
        "null"
      ]
    },
    "kpis": {
      "type": "object"
    },
    "worker_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "skill",
          "state",
          "error_code",
          "detail"
        ]
      }
    }
  }
}
