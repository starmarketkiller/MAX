; NEXUS Edge Book — GOLD shortlist (credit-safe, NOT validated production edge)
; InpBookMode=1 → NXS_BOOK_EDGE_SHORTLIST
; Load on a GOLD/XAUUSD chart with Strategy Profiles ON.
; Every non-shortlist toggle that defaults true in NXS_Inputs.mqh is forced false.

InpBookMode=1
InpRiskProfile=0
InpUseStrategyProfiles=true
InpProfileMultiTF=true
InpUseInstitutionalCore=false
InpDataCollectionMode=false
InpResearchMode=false
InpStrategySelector=0
InpLiveTradingAuthorized=false

; --- shortlist ON ---
InpStrat_FVG_CONT=true
InpStrat_LIQ_SWEEP=true
InpStrat_ORDER_BLOCK=true
InpStrat_BREAKOUT_ACC=true
InpStrat_ZScoreBreakout=true
InpStrat_EMA_PULLBACK=true

; --- hard-deny / freeze OFF ---
InpStrat_MACD=false
InpStrat_RSI_DIV=false
InpStrat_TSI=false
InpStrat_BB_SQUEEZE=false
InpStrat_SH_BMS_RTO=false
InpStrat_SH_BMS_RTO_V2=false
InpStrat_SilverBullet=false

; --- other defaults that are true in NXS_Inputs OFF for a clean shortlist book ---
InpStrat_ADX_RSI=false
InpStrat_BOLLINGER=false
InpStrat_SAR=false
