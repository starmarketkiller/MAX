string NXS_StrategyCanonicalId(string strategyId){
   string id=strategyId;
   int n=StringLen(id);
   if(n>4 && StringSubstr(id,n-4)=="_NXR") id=StringSubstr(id,0,n-4);
   if(id=="CISD") id="THREE_BAR_DELIVERY_BREAK";
   return id;
}

bool NXS_StrategyKnown(string strategyId){
