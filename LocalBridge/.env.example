# ============================================================
# NEXUS Local Agent Bridge V1 - configurazione client Windows
# Copia questo file in ".env" (nella stessa cartella LocalBridge/) e
# sostituisci i valori. Non committare mai il file ".env" risultante
# (gia' coperto da .gitignore: "LocalBridge/.env" e "LocalBridge/.env.*").
# ============================================================

# URL pubblico del backend NEXUS su Render.
NEXUS_URL=https://nexus-backend-8o4y.onrender.com

# Identificativo di questa workstation (solo per log/stato, non segreto).
NEXUS_LOCAL_AGENT_BRIDGE_ID=primary-workstation

# Stesso valore configurato come secret su Render
# (NEXUS_LOCAL_AGENT_BRIDGE_SECRET). Minimo 32 caratteri casuali.
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_LOCAL_AGENT_BRIDGE_SECRET=<GENERA>

# Percorso del checkout locale del repo MAX.
NEXUS_REPO_ROOT=C:\path\to\MAX

# Cartella per le workspace isolate usate durante l'esecuzione dei task
# (mai il repo reale). Puo' stare fuori dal repo.
NEXUS_LOCAL_AGENT_WORKSPACE=C:\path\outside-or-inside-checkout\nexus-bridge-workspaces

# Intervallo di polling in secondi (default 3 se non impostato).
NEXUS_LOCAL_AGENT_POLL_SECONDS=3
