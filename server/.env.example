# ============================================================
# NEXUS self-hosted backend — configurazione
# Copia questo file in ".env" e sostituisci OGNI valore segnato <GENERA>.
#
# I segnaposto NON sono utilizzabili: con NEXUS_ENV diverso da
# DEVELOPMENT/SIMULATION il backend rifiuta di avviarsi finché restano
# invariati (preflight di sicurezza, finding AUD0-SEC-001 / AUD0-SEC-004).
# ============================================================

# Ambiente canonico: DEVELOPMENT | SIMULATION | DEMO | PAPER | LIVE.
# Da DEMO in su tutti i controlli fail-closed diventano bloccanti.
# Un valore sconosciuto viene trattato come LIVE.
NEXUS_ENV=DEVELOPMENT

# Token condiviso EA <-> Backend <-> LocalBridge worker.
# DEVE essere identico a InpWebToken nell'EA e a bridge_token nel worker.
# Genera:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NOTA (AUD0-SEC-003): un solo token autentica EA, backend e worker. È un
# dominio di fiducia ampio: la compromissione di un componente permette di
# impersonare gli altri. Credenziali per-principale sono nel backlog (PR-02).
NEXUS_BRIDGE_TOKEN=<GENERA>

# Credenziali per accedere alla dashboard web.
# La dashboard React presenta il campo utente come email: usa un indirizzo.
NEXUS_ADMIN_USER=<tua-email@esempio.it>
# Minimo 12 caratteri, non riutilizzata altrove.
NEXUS_ADMIN_PASSWORD=<GENERA>

# Segreto per firmare i token di sessione della dashboard (JWT).
# Genera:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se assente, il backend ne genererebbe uno effimero: ogni riavvio
# invaliderebbe tutte le sessioni (AUD0-SEC-005).
NEXUS_JWT_SECRET=<GENERA>

# Durata sessione dashboard (ore). Massimo 24 negli ambienti non di sviluppo:
# questa sessione può chiudere posizioni e modificare il rischio.
NEXUS_JWT_HOURS=12

# Cookie di sessione "secure" (solo HTTPS). true su Render; metti false solo
# per test in locale via http.
NEXUS_COOKIE_SECURE=true

# Origin ammesse per le mutazioni autenticate via cookie (anti-CSRF).
# Elenco separato da virgole, es. https://nexus.onrender.com
NEXUS_ALLOWED_ORIGINS=

# Percorso del database SQLite (dentro al container è /data/nexus.db).
NEXUS_DB_PATH=/data/nexus.db

# Dimensione massima dei body JSON accettati (byte).
NEXUS_MAX_BODY_BYTES=524288

# (Opzionale) Notifiche Telegram. Se vuoti, i messaggi vengono solo loggati.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Licenza: "open" accetta QUALUNQUE chiave — utile solo in sviluppo.
# In DEMO/PAPER/LIVE deve essere "strict", altrimenti l'avvio fallisce.
NEXUS_LICENSE_MODE=strict

# AI Coach — chiave API Claude (https://console.anthropic.com). Senza questa
# chiave il Coach risponde con un messaggio di "non disponibile".
ANTHROPIC_API_KEY=
# Modello usato dal Coach (claude-opus-4-8 o claude-sonnet-4-6).
NEXUS_COACH_MODEL=claude-opus-4-8

# L'AI Coach NON ha autorità di esecuzione: produce proposte, non muta lo
# stato di trading. Abilitabile solo in sviluppo (AUD0-AI-001).
NEXUS_COACH_ALLOW_ACTIONS=false
